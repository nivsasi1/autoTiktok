# Optional: descriptive User-Agent for Reddit's public RSS feeds
# (Reddit etiquette: include your reddit username)
REDDIT_USER_AGENT=autoTiktok/1.0 by u/<your-username>

# Optional: email alerts on upload failures / crashed runs (off when unset).
# Gmail: enable 2FA, create an app password at myaccount.google.com/apppasswords
NOTIFY_EMAIL_TO=you@example.com
NOTIFY_SMTP_USER=you@gmail.com
NOTIFY_SMTP_PASSWORD=<16-char app password>
# NOTIFY_SMTP_HOST=smtp.gmail.com
# NOTIFY_SMTP_PORT=587
